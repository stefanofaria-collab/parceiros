# Copie para sync/.env.sync (arquivo local e ignorado pelo Git).
# Não cole senhas ou chaves no GitHub.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ID de projeto Google Cloud com faturamento configurado.
BQ_PROJECT_ID=
BQ_DATASET=parceiros
BQ_TABLE=clientes_parceiros
BQ_LOCATION=US

# Caminho absoluto para JSON da conta de serviço escritora no Windows.
GCP_SYNC_CREDENTIALS=
MAX_SYNC_ROWS=250000
